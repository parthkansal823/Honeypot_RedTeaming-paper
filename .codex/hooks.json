{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python 'd:\\Projects\\Project_With_Keshav\\Honeypot_ResearchPaper\\.codex\\hooks\\guard.py' pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python 'd:\\Projects\\Project_With_Keshav\\Honeypot_ResearchPaper\\.codex\\hooks\\guard.py' post",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python 'd:\\Projects\\Project_With_Keshav\\Honeypot_ResearchPaper\\.codex\\hooks\\guard.py' status",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
