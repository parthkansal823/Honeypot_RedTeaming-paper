<mxfile host="app.diagrams.net" type="device"><diagram id="d06_normalization_pipeline" name="Command normalization"><mxGraphModel dx="590" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="590" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="1  Raw command&lt;br&gt;from a session" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="270" height="60" as="geometry"/></mxCell><mxCell id="n2" value="2  Lower-case; cut leaked&lt;br&gt;chat tokens (&amp;lt;|...)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="10" width="270" height="60" as="geometry"/></mxCell><mxCell id="n3" value="3  Mask URLs, IPs, quoted&lt;br&gt;text, hex, numbers" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="95" width="270" height="60" as="geometry"/></mxCell><mxCell id="n4" value="4  Mask the random&lt;br&gt;busybox tag" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="10" y="95" width="270" height="60" as="geometry"/></mxCell><mxCell id="n5" value="5  Split on ; | &amp;amp;&amp;amp; || $( `&lt;br&gt;→ segments" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="10" y="180" width="270" height="60" as="geometry"/></mxCell><mxCell id="n6" value="6  Verbs, tactic tags,&lt;br&gt;template key" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=11;