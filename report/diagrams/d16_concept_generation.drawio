<mxfile host="app.diagrams.net" type="device"><diagram id="d16_concept_generation" name="Concept generation"><mxGraphModel dx="590" dy="490" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="590" pageHeight="490" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="root" value="How can a defender get enough&lt;br&gt;labelled attack sessions?" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="10" width="350" height="56" as="geometry"/></mxCell><mxCell id="c2" value="C2  Scripted synthetic generator&lt;br&gt;(fixed archetypes)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="10" y="110" width="260" height="64" as="geometry"/></mxCell><mxCell id="c4" value="C4  LLM agent vs&lt;br&gt;static Cowrie" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="260" height="64" as="geometry"/></mxCell><mxCell id="c3" value="C3  Generative models&lt;br&gt;(GANs over traffic)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="10" y="190" width="260" height="64" as="geometry"/></mxCell><mxCell id="c5" value="C5  LLM agent vs&lt;br&gt;LLM-backed Cowrie" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="320" y="190" width="260" height="64" as="geometry"/></mxCell><mxCell id="c1" value="C1  Collect more real data&lt;br&gt;(own internet honeypots)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="10" y="270" width="260" height="64" as="geometry"/></mxCell><mxCell id="c6" value="C6  Replay or mutate&lt;br&gt;real sessions" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="320" y="270" width="260" height="64" as="geometry"/></mxCell><mxCell id="out" value="Selected: C4 + C5 (two honeypot conditions), compared with public&lt;br&gt;real data (the C1 side, without waiting for our own deployment).&lt;br&gt;Kept for future work: C1 (own deployment) and C6 (replay).&lt;br&gt;Rejected now: C2 (no realism) and C3 (needs a lot of real data)." style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontFamily=Arial;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="10" y="365" width="570" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="root" target="c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="295" y="142"/></Array></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="root" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="295" y="142"/></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF