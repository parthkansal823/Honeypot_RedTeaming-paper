<mxfile host="app.diagrams.net" type="device"><diagram id="d05_cyberlab_parser_flowchart" name="CyberLab parser"><mxGraphModel dx="590" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="590" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="in" value="cowrie_2019-11-15.json&lt;br&gt;(one JSON array, about 600 MB)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="145" y="8" width="300" height="50" as="geometry"/></mxCell><mxCell id="rd" value="Read ONE line; strip &amp;#x27;[&amp;#x27; &amp;#x27;,&amp;#x27; &amp;#x27;]&amp;#x27;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="145" y="76" width="300" height="40" as="geometry"/></mxCell><mxCell id="js" value="Valid JSON?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="130" width="170" height="58" as="geometry"/></mxCell><mxCell id="skip" value="Skip the line" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="140" width="140" height="38" as="geometry"/></mxCell><mxCell id="blk" value="For each {session_id: [events]}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="145" y="204" width="300" height="40" as="geometry"/></mxCell><mxCell id="mrg" value="Get or create the session record&lt;br&gt;(one session can repeat)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8