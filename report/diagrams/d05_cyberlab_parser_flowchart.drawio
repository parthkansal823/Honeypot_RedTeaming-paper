<mxfile host="app.diagrams.net" type="device"><diagram id="d05_cyberlab_parser_flowchart" name="CyberLab parser"><mxGraphModel dx="720" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="in" value="cowrie_2019-11-15.json&lt;br&gt;(one big JSON array, ~600 MB)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="210" y="20" width="300" height="60" as="geometry"/></mxCell><mxCell id="rd" value="Read ONE line at a time&lt;br&gt;strip &amp;#x27;[&amp;#x27; &amp;#x27;,&amp;#x27; &amp;#x27;]&amp;#x27; around it" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="210" y="115" width="300" height="60" as="geometry"/></mxCell><mxCell id="js" value="Valid JSON&lt;br&gt;object?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="270" y="210" width="180" height="90" as="geometry"/></mxCell><mxCell id="skip" value="Skip the line" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="225" width="170" height="60" as="geometry"/></mxCell><mxCell id="blk" value="For every {session_id: [events]}&lt;br&gt;in the object" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="210" y="335" width="300" height="60" as="geometry"/></mxCell><mxCell id="mrg" value="Get or create the session record&lt;br&gt;(a session can appear twice)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="210" y="430" width="300" height="60" as="geometry"/></mxCell><mxCell id="srt" value="Sort its events by timestamp" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="210" y="525" width="300" height="50" as="geometry"/></mxCell><mxCell id="map" value="Map each event into the record&lt;br&gt;session.connect → protocol (ssh / telnet)&lt;br&gt;login.success / login.failed → login_attempts[]&lt;br&gt;command.input → commands[] (drop the &amp;#x27;CMD: &amp;#x27; prefix)&lt;br&gt;session.file_download / upload → downloads[]&lt;br&gt;client.version → client_version&lt;br&gt;session.closed → duration_s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="140" y="610" width="440" height="170" as="geometry"/></mxCell><mxCell id="more" value="More lines?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="270" y="815" width="180" height="80" as="geometry"/></mxCell><mxCell id="out" value="Add findings + counts, write one JSON line per session&lt;br&gt;→ normalized/real_organic.jsonl (76,785 sessions)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="160" y="930" width="400" height="64" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="in" target="r