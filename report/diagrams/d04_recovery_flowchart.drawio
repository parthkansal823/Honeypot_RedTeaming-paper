<mxfile host="app.diagrams.net" type="device"><diagram id="d04_recovery_flowchart" name="Session retry and recovery"><mxGraphModel dx="760" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="st" value="Next session requested" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="20" width="240" height="50" as="geometry"/></mxCell><mxCell id="probe" value="ensure_honeypot_healthy():&lt;br&gt;raw-socket SSH banner probe" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="260" height="60" as="geometry"/></mxCell><mxCell id="ok" value="Banner&lt;br&gt;received?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="195" width="180" height="90" as="geometry"/></mxCell><mxCell id="fix" value="Remote restart over admin&lt;br&gt;SSH (if --vm-host set),&lt;br&gt;else wait for watchdog" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="200" width="220" height="80" as="geometry"/></mxCell><mxCell id="back" value="Back within&lt;br&gt;90 s?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="540" y="320" width="180" height="90" as="geometry"/></mxCell><mxCell id="give" value="Log connection_failed;&lt;br&gt;give up on this session" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="450" width="220" height="54" as="geometry"/></mxCell><mxCell id="run" value="run_session(): drive the&lt;br&gt;attacker loop" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="330" width="260" height="60" as="geometry"/></mxCell><mxCell id="infra" value="Status is an infra&lt;br&gt;failure? (failed /&lt;br&gt;unresponsive / lost)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="430" width="200" height="110" as="geometry"/></mxCell><mxCell id="keep" value="Keep log as real data&lt;br&gt;(completed, refused, ...)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="455" width="200" height="60" as="geometry"/></mxCell><mxCell id="left" value="Retries left?&lt;br&gt;(max 3)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="580" width="180" height="90" as="geometry"/></mxCell><mxCell id="retry" value="Save failed attempt,&lt;br&gt;wait 3 s, retry" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="595" width="210" height="60" as="geometry"/></mxCell><mxCell id="ex" value="Save last log&lt;br&gt;(retries exhausted)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="270" y="720" width="220" height="54" as="geometry"/></mxCell><mxCell id="end" value="Session f