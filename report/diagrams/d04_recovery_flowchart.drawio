<mxfile host="app.diagrams.net" type="device"><diagram id="d04_recovery_flowchart" name="Session retry and recovery"><mxGraphModel dx="590" dy="550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="590" pageHeight="550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="st" value="Next session" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="195" y="8" width="200" height="32" as="geometry"/></mxCell><mxCell id="probe" value="Probe SSH banner&lt;br&gt;(raw socket, 5 s)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="175" y="54" width="240" height="44" as="geometry"/></mxCell><mxCell id="ok" value="Banner&lt;br&gt;received?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="112" width="170" height="58" as="geometry"/></mxCell><mxCell id="fix" value="Restart over admin&lt;br&gt;SSH (--vm-host), else&lt;br&gt;wait for watchdog" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="104" width="172" height="74" as="geometry"/></mxCell><mxCell id="back" value="Back in&lt;br&gt;90 s?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="426" y="196" width="140" height="58" as="geometry"/></mxCell><mxCell id="give" value="Give up:&lt;br&gt;connection_failed" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y