<mxfile host="app.diagrams.net" type="device"><diagram id="d25_class_diagram" name="Class diagram"><mxGraphModel dx="590" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="590" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cfg" value="&lt;b&gt;RunConfig «dataclass»&lt;/b&gt;&lt;hr&gt;host: str;  port: int&lt;br&gt;provider: str;  model: str&lt;br&gt;max_turns: int = 25&lt;br&gt;max_session_seconds: float = 600&lt;br&gt;response_wait: float = 1.5&lt;br&gt;max_response_wait: float = 20&lt;br&gt;max_session_retries: int = 3&lt;br&gt;recovery_max_wait: float = 90" style="rounded=0;verticalAlign=top;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="280" height="190" as="geometry"/></mxCell><mxCell id="hp" value="&lt;b&gt;HoneypotSession&lt;/b&gt;&lt;hr&gt;client: SSHClient;  shell: Channel&lt;br&gt;banner: str&lt;br&gt;+ _drain(idle, max_wait) → str&lt;br&gt;+ send_command(cmd) → (str, float)&lt;br&gt;+ close()" style="rounded=0;verticalAlign=top;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="10" width="280" height="150" as="geometry"/></mxCell><mxCell id="run" value="&lt;b&gt;session runner «functions»&lt;/b&gt;&lt;hr&gt;+ run_session(cfg, i) → dict&lt;br&gt;+ run_session_with_recovery(cfg, i)&lt;br&gt;+ ensure_honeypot_healthy(cfg)&lt;br&gt;+ save_log(log, dir) → Path" style="rounded=0;verticalAlign=top;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="190" width="280" height="140" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;LLM client «functions»&lt;/b&gt;&lt;hr&gt;+ call_llm(provider, model